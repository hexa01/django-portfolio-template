SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8055,http://127.0.0.1:8055

# Host port for docker compose (container listens on 8000)
WEB_PORT=8055

# Dev only: your host uid/gid (run `id -u` / `id -g`), so files created in the container are yours
DEV_UID=1000
DEV_GID=1000

# Postgres container creates the DB from these on first start;
# compose builds Django's DATABASE_URL from them too.
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me

# ---- Server (production) values: copy to the server's .env and change ----
# SECRET_KEY=<long random string: python -c "import secrets; print(secrets.token_urlsafe(50))">
# DEBUG=False
# ALLOWED_HOSTS=example.com,www.example.com,localhost
# CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
# SITE_INDEXABLE=False            # True on launch day
# SECURE_HSTS_SECONDS=3600        # raise to 31536000 once HTTPS works
# WEB_PORT=8055                   # Nginx proxies to 127.0.0.1:WEB_PORT
# APP_UID=1000                    # `id -u` of the user owning the repo checkout (and ./media)
# APP_GID=1000                    # `id -g`
# GUNICORN_WORKERS=3              # about 2 x CPU cores + 1
# POSTGRES_PASSWORD=<long random string>
